<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@write.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unito.progiii.progiiiclient.controllers.WriteController">
   <center>
      <VBox prefHeight="396.0" prefWidth="600.0" spacing="5" BorderPane.alignment="CENTER">
         <padding>
            <Insets topRightBottomLeft="20" />
         </padding>
         <Label text="Destinatari (separati da virgole)" />
         <TextField fx:id="receiversInput" />
         <Label text="Oggetto" />
         <TextField fx:id="subjectInput" />
         <Label text="Contenuto" />
         <TextArea fx:id="contentText" prefHeight="255.0" prefWidth="600.0" />
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="36.0" prefWidth="600.0" spacing="55">
         <Button id="submit-button" mnemonicParsing="false" onAction="#sendEmail" text="Invia" />
         <Button mnemonicParsing="false" onAction="#close" text="Annulla" />
      </HBox>
   </bottom>
</BorderPane>
